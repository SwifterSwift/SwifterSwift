#!/bin/bash
#
# Formats staged Swift files with `swift format` before each commit.
#
# Install it from the repository root with:
#
#     ln -sf ../../scripts/pre-commit .git/hooks/pre-commit
#

if ! swift format --version > /dev/null 2>&1; then
    echo "warning: swift format isn't available (skipping)"
    exit 0
fi

git diff --cached --name-only --diff-filter=d -z -- '*.swift' | while IFS= read -r -d '' file; do
    swift format format --in-place "$file"
    git add -- "$file"
done
